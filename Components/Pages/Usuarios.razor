@page "/usuarios"

<section class="mx-auto max-w-7xl p-4">
    <div class="mb-8 text-center">
        <h1 class="text-4xl font-bold tracking-tight text-stone-900">Usuarios</h1>
        <p class="mt-2 text-stone-500">Lista de usuarios registrados</p>
    </div>

    <div class="grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-4">
        @foreach (Usuario usuario in lstUsuarios.OrderBy(u => u.Nombre))
        {
            <div class="flex flex-col gap-2 rounded-2xl border border-stone-200 bg-white p-5 shadow-sm">
                <h2 class="text-xl font-bold text-stone-900">@usuario.Nombre</h2>
                <p class="text-sm text-stone-500">@usuario.Email</p>
                <span class="w-fit rounded-full bg-amber-500 px-3 py-1 text-sm font-bold text-white">@usuario.Rol</span>
            </div>
        }
    </div>
</section>

@code {
    private List<Usuario> lstUsuarios = new()
    {
        new Usuario("Pedro", "pedro@correo.com", "Cliente"),
        new Usuario("Ana", "ana@correo.com", "Admin"),
        new Usuario("Luis", "luis@correo.com", "Cliente"),
        new Usuario("Carla", "carla@correo.com", "Barista"),
        new Usuario("Miguel", "miguel@correo.com", "Cliente"),
        new Usuario("Beatriz", "beatriz@correo.com", "Barista"),
        new Usuario("Jorge", "jorge@correo.com", "Cliente"),
        new Usuario("Daniela", "daniela@correo.com", "Admin")
    };

    public class Usuario
    {
        public string? Nombre { get; set; }
        public string? Email { get; set; }
        public string? Rol { get; set; }

        public Usuario(string nombre, string email, string rol)
        {
            Nombre = nombre;
            Email = email;
            Rol = rol;
        }
    }
}
