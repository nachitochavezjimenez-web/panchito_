@page "/catalogo"

<section class="mx-auto max-w-7xl p-4">
    <div class="mb-8 text-center">
        <h1 class="text-4xl font-bold tracking-tight text-stone-900">Nuestro Café</h1>
        <p class="mt-2 text-stone-500">Preparado al momento, como te gusta</p>
    </div>

    <div class="grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-4">
        @foreach (Cafe cafe in lstCafes)
        {
            <div class="group flex flex-col overflow-hidden rounded-2xl border border-stone-200 bg-white shadow-sm transition duration-300 hover:-translate-y-1 hover:shadow-xl hover:shadow-amber-900/10">
                <div class="relative h-48 overflow-hidden">
                    <img src="@cafe.Imagen" alt="@cafe.NombreCafe" class="h-full w-full object-cover transition duration-500 group-hover:scale-110" />
                    <span class="absolute right-3 top-3 rounded-full bg-amber-500 px-3 py-1 text-sm font-bold text-white shadow-md">@cafe.PrecioCafe Bs.</span>
                </div>
                <div class="flex flex-1 flex-col gap-2 p-5">
                    <h2 class="text-xl font-bold text-stone-900">@cafe.NombreCafe</h2>
                    <p class="text-sm text-stone-500">@cafe.DescripcionCafe</p>
                </div>
            </div>
        }
    </div>
</section>

