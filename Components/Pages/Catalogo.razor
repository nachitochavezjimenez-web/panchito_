@page "/catalogo"
@rendermode InteractiveServer
@using sharpness_sharp.Components.UIcomponents

<section class="mx-auto max-w-7xl p-4">
    <div class="mb-8 text-center">
        <h1 class="text-4xl font-bold tracking-tight text-stone-900">Nuestro Café</h1>
        <p class="mt-2 text-stone-500">Preparado al momento, como te gusta</p>
    </div>

    <div class="mb-6 flex flex-col items-center gap-3">
        <button @onclick="MostrarMensaje" class="ui-btn ui-btn-primary">Pulsame Baby</button>

        @foreach (var mensaje in lstMensajes)
        {
            <p class="text-stone-700">@mensaje</p>
        }
    </div>

    <div class="mb-6 flex flex-wrap justify-center gap-3">
        <input @bind="nuevoNombre" placeholder="Nombre" class="rounded-lg border border-stone-300 px-3 py-2" />
        <input @bind="nuevaDescripcion" placeholder="Descripción" class="rounded-lg border border-stone-300 px-3 py-2" />
        <input @bind="nuevaImagen" placeholder="URL de la imagen" class="rounded-lg border border-stone-300 px-3 py-2" />
        <input type="number" @bind="nuevoPrecio" placeholder="Precio" class="w-28 rounded-lg border border-stone-300 px-3 py-2" />
        <button @onclick="AgregarCafe" class="ui-btn ui-btn-primary">Agregar café</button>
    </div>

    <div class="grid gap-6 p-6 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4">
        @foreach (var cafe in lstCafes)
        {
            <CoffeCard Imagen="@cafe.Imagen"
                       NombreCafe="@cafe.NombreCafe"
                       DescripcionCafe="@cafe.DescripcionCafe"
                       PrecioCafe="@cafe.PrecioCafe" />
        }
    </div>
</section>

