

<div> </div><div class="group flex flex-col overflow-hidden rounded-2xl border border-stone-200 bg-white shadow-sm transition duration-300 hover:-translate-y-1 hover:shadow-xl hover:shadow-amber-900/10">
    <div class="relative h-48 overflow-hidden">
        <img src="@Imagen" alt="@NombreCafe" class="h-full w-full object-cover transition duration-500 group-hover:scale-110" />
        <span class="absolute right-3 top-3 rounded-full bg-amber-500 px-3 py-1 text-sm font-bold text-white shadow-md">@PrecioCafe Bs.</span>
    </div>
    <div class="flex flex-1 flex-col gap-2 p-5">
        <h2 class="text-xl font-bold text-stone-900">@NombreCafe</h2>
        <p class="text-sm text-stone-500">@DescripcionCafe</p>
    </div>
</div>

@code {
    [Parameter] public string? Imagen { get; set; }
    [Parameter] public string? NombreCafe { get; set; }
    [Parameter] public string? DescripcionCafe { get; set; }
    [Parameter] public decimal PrecioCafe { get; set; }
}
   